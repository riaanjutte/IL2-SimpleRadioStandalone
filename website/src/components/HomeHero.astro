---
import { Image } from 'astro:assets';
import darkClient from '../assets/client-main.png';
import lightClient from '../assets/client-main-light.png';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="client-showcase" aria-label="SRS client themes">
	<a class="client-preview dark-client" href={`${base}screenshots/`} aria-label="View the dark client screenshot">
		<Image
			src={darkClient}
			alt="SRS for IL-2 client using the dark theme"
			width={1182}
			quality="high"
			loading="eager"
		/>
	</a>
	<a class="client-preview light-client" href={`${base}screenshots/`} aria-label="View the light client screenshot">
		<Image
			src={lightClient}
			alt="SRS for IL-2 client using the light theme"
			width={1182}
			quality="high"
			loading="eager"
		/>
	</a>
</section>

<style>
	.client-showcase {
		max-width: 40rem;
		margin: 0 auto;
		padding: 0 1.5rem 3.5rem;
	}
	.client-preview {
		display: block;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 5px;
		background: var(--sl-color-black);
		box-shadow: 0 1.25rem 2.75rem rgba(0, 0, 0, 0.22);
		overflow: hidden;
	}
	.client-preview img {
		display: block;
		width: 100%;
		height: auto;
	}
	:global(html[data-theme='dark']) .light-client,
	:global(html[data-theme='light']) .dark-client {
		display: none;
	}
	@media (max-width: 50rem) {
		.client-showcase {
			padding: 0 1rem 2.5rem;
		}
	}
</style>
