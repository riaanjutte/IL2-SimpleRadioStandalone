@page "/api-keys"
@attribute [Authorize]
@inject ServerAdminService Admin
@inject IAdminActor AdminActor

<PageTitle>API Keys · IL2-SRS Server</PageTitle>

<div class="page-head">
    <h1>API Keys</h1>
    <div class="actions">
        <a class="btn btn-quiet" href="scalar" target="_blank" rel="noopener">API reference</a>
        <a class="btn btn-quiet" href="openapi/v1.json" target="_blank" rel="noopener">OpenAPI document</a>
    </div>
</div>

<p class="muted">
    Send a key as <code>Authorization: Bearer &lt;key&gt;</code> to <code>/api/v1/…</code>.
    <strong>Read</strong> keys can view status, clients, settings, bans and events.
    <strong>Write</strong> keys can also change settings, kick, ban and mute, and start or stop the server.
    Use HTTPS (for example a reverse proxy) when keys are sent over the internet.
</p>

<section class="panel">
    <h2>Create a key</h2>
    <form class="inline-form" novalidate @onsubmit="Create">
        <div class="form-field grow">
            <label for="key-name">Name</label>
            <input id="key-name" type="text" maxlength="@ApiKeyStore.MaxNameLength" placeholder="Discord bot"
                   aria-invalid="@FieldError.Invalid(NameError)"
                   aria-describedby="@FieldError.DescribedBy("key-name-error", NameError)"
                   @ref="_nameInput" @bind="_name" @bind:event="oninput" @onblur="() => _form.Touch(NameField)" />
            <FieldError Id="key-name-error" Message="@NameError" />
        </div>
        <label>
            <span>Access</span>
            <select @bind="_scope">
                <option value="@ApiScope.Read">Read</option>
                <option value="@ApiScope.Write">Write</option>
            </select>
        </label>
        <div class="form-button">
            <span aria-hidden="true">&nbsp;</span>
            <button type="submit" class="btn btn-primary">Create</button>
        </div>
    </form>
    @if (_error != null)
    {
        <p class="alert alert-error" role="alert">@_error</p>
    }
    @if (_newKey != null)
    {
        <div class="alert new-key" role="status">
            <p><strong>Copy this key now.</strong> It is not stored and cannot be shown again.</p>
            <code class="key">@_newKey</code>
        </div>
    }
</section>

@if (_keys.Count == 0)
{
    <p class="muted empty">No API keys.</p>
}
else
{
    <div class="table-wrap">
        <table class="grid">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Key</th>
                    <th>Access</th>
                    <th>Created</th>
                    <th>Last used</th>
                    <th class="actions-col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var key in _keys)
                {
                    <tr @key="key.Id" class="@(key.IsRevoked ? "row-muted" : "")">
                        <td>@key.Name</td>
                        <td class="mono nowrap">srs_@(key.Prefix)_…</td>
                        <td>@key.Scope</td>
                        <td><LocalTime Value="key.CreatedAtUtc" /></td>
                        <td class="date">@if (key.LastUsedAtUtc.HasValue) { <LocalTime Value="key.LastUsedAtUtc.Value" /> } else { <text>never</text> }</td>
                        <td class="actions-col">
                            @if (key.IsRevoked)
                            {
                                <span class="muted">revoked</span>
                            }
                            else
                            {
                                <ConfirmButton Text="Revoke" Question="Revoke key?" ConfirmText="Revoke"
                                               OnConfirm="() => Revoke(key)" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<ApiKeyRecord> _keys = Array.Empty<ApiKeyRecord>();
    private string _name;
    private string _scope = ApiScope.Read;
    private string _newKey;
    private string _error;
    private readonly FormState _form = new();
    private ElementReference _nameInput;

    private const string NameField = "name";
    private string NameError => _form.Show(NameField, ApiKeyStore.ValidateName(_name));
    private string Actor => AdminActor.Name;

    protected override void OnInitialized() => _keys = Admin.GetApiKeys();

    private async Task Create()
    {
        _error = null;
        _form.Submit();
        if (NameError != null)
        {
            _newKey = null;
            await _nameInput.FocusAsync();
            return;
        }

        try
        {
            _newKey = Admin.CreateApiKey(_name, _scope, Actor, out _);
            _name = null;
            _form.Reset();
        }
        catch (InvalidOperationException ex)
        {
            _newKey = null;
            _error = ex.Message;
        }

        _keys = Admin.GetApiKeys();
    }

    private void Revoke(ApiKeyRecord key)
    {
        Admin.RevokeApiKey(key.Id, Actor);
        _newKey = null;
        _keys = Admin.GetApiKeys();
    }
}
