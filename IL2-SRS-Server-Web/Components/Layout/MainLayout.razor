@inherits LayoutComponentBase
@inject ServerAdminService Admin
@inject AdminAuthOptions AuthOptions
@inject IEnumerable<AdminNavItem> ExtraNavItems
@inject NavigationManager Navigation

<div class="shell">
    <header class="topbar">
        <a class="brand" href="">
            <img src="favicon.ico" alt="" width="24" height="24" />
            <span>IL2-SRS Server</span>
        </a>
        <span class="topbar-meta">v@(Admin.Version) · port @Admin.Port</span>
        <button type="button" class="btn btn-quiet theme-toggle" data-theme-toggle aria-label="Theme">
            <Icon Name="monitor" Class="theme-label theme-label-desktop" />
            <Icon Name="sun" Class="theme-label theme-label-light" />
            <Icon Name="moon" Class="theme-label theme-label-dark" />
            <Icon Name="radio" Class="theme-label theme-label-srs" />
        </button>
        @if (!AuthOptions.Disabled)
        {
            <form method="post" action="account/logout" class="logout">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-quiet">Log out</button>
            </form>
        }
    </header>

    @* On phones the menu is a dropdown named after the current page; side by side the toggle is hidden. *@
    <nav class="sidenav @(MenuOpen ? "open" : null)" aria-label="Main" @onkeydown="CloseOnEscape">
        <button type="button" class="nav-toggle" aria-expanded="@(MenuOpen ? "true" : "false")" aria-controls="nav-links"
                @onclick="ToggleMenu">
            <span>@CurrentLabel</span>
            <Icon Name="chevron-down" />
        </button>
        <div class="nav-links" id="nav-links">
            @foreach (var item in NavItems)
            {
                <NavLink href="@item.Href" Match="@(item.Href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)">@item.Label</NavLink>
            }
        </div>
    </nav>
    @if (MenuOpen)
    {
        <div class="nav-backdrop" @onclick="CloseMenu"></div>
    }

    @* Only the content scrolls. A new element per page, so each page starts at the top (the router only
       scrolls the window); filters that change the query string keep their place. *@
    <main class="content" @key="new Uri(Navigation.Uri).AbsolutePath">
        <div class="content-inner">
            @Body
        </div>
    </main>
</div>

<Toasts />

<div id="blazor-error-ui" data-nosnippet>
    The connection to the server was interrupted.
    <a href="" class="reload">Reload</a>
</div>

@code {
    // The page the phone menu was opened on; it is open only while that page is shown, so it closes on navigation.
    private string _menuOpenOn;

    private string CurrentPath => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');

    private bool MenuOpen => _menuOpenOn != null && _menuOpenOn == CurrentPath;

    private IEnumerable<AdminNavItem> NavItems =>
        new[]
        {
            new AdminNavItem("", "Dashboard"),
            new AdminNavItem("clients", "Clients"),
            new AdminNavItem("settings", "Settings"),
            new AdminNavItem("channels", "Channel Names"),
            new AdminNavItem("bans", "Bans"),
            new AdminNavItem("events", "Event Log"),
            new AdminNavItem("api-keys", "API Keys")
        }
        .Concat(ExtraNavItems)
        .Append(new AdminNavItem("plugins", "Plugins"));

    // The longest matching link, as NavLink marks it active (plugin pages like integrations/runs included).
    private string CurrentLabel
    {
        get
        {
            var path = CurrentPath;
            var current = NavItems
                .Where(i => i.Href.Length == 0 ? path.Length == 0 : path.Equals(i.Href, StringComparison.OrdinalIgnoreCase) || path.StartsWith(i.Href + "/", StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(i => i.Href.Length)
                .FirstOrDefault();
            return current?.Label ?? "Menu";
        }
    }

    private void ToggleMenu() => _menuOpenOn = MenuOpen ? null : CurrentPath;

    private void CloseMenu() => _menuOpenOn = null;

    private void CloseOnEscape(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseMenu();
        }
    }
}
