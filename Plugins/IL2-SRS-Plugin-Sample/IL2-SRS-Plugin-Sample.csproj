<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The smallest useful plugin: a page, a stylesheet, an event type and an API endpoint. The server's tests
       install it from a plugin folder; it is not shipped. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>IL2-SRS-Plugin-Sample</AssemblyName>
    <RootNamespace>Ciribob.IL2.SimpleRadio.Standalone.Server.Sample</RootNamespace>
    <Version>1.0.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The server provides the SDK; don't ship a copy with the plugin. -->
    <ProjectReference Include="..\..\IL2-SRS-Server-Abstractions\IL2-SRS-Server-Abstractions.csproj"
                      Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Served at plugins/sample/. -->
    <None Include="Assets\**" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
